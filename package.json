{
  "name": "@sphyra/js",
  "version": "1.2.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Framework-agnostic JavaScript/TypeScript SDK for the Sphyra map & geocoding API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sphyra/sdk-js.git"
  },
  "homepage": "https://github.com/sphyra/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/sphyra/sdk-js/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mapbox/mapbox-gl-draw": "^1.4.3",
    "maplibre-gl": "^5.24.0"
  },
  "peerDependenciesMeta": {
    "@mapbox/mapbox-gl-draw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "5.24.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.5"
  }
}
